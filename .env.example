# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by Prisma (backend)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gym_management

# Backend API
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Auth — generate with: openssl rand -hex 32 (min 16 characters)
JWT_SECRET=generate-a-long-random-secret-here
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false

# Frontend (Next.js) — BACKEND_URL is used by the /api rewrite proxy
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
