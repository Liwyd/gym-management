# syntax=docker/dockerfile:1
# Build context must be the repository root:
#   docker build -f docker/Dockerfile.backend .

FROM node:22-alpine AS build
WORKDIR /app

COPY backend/package.json backend/package-lock.json ./
RUN npm ci

COPY backend/prisma ./prisma
RUN npx prisma generate

COPY backend/tsconfig.json backend/tsconfig.build.json ./
COPY backend/src ./src
RUN npm run build

# Compile the seed so the runtime image stays prod-only (no tsx).
RUN npx tsc prisma/seed.ts \
  --outDir dist/prisma \
  --module commonjs \
  --moduleResolution node \
  --target es2022 \
  --esModuleInterop \
  --skipLibCheck

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY backend/package.json backend/package-lock.json ./
RUN npm ci --omit=dev && npm install -g prisma@6

COPY backend/prisma ./prisma
COPY --from=build /app/dist ./dist
# Generated Prisma client (query engine lives under .prisma/client).
COPY --from=build /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=build /app/node_modules/@prisma/client ./node_modules/@prisma/client

EXPOSE 4000
CMD ["sh", "-c", "prisma migrate deploy && node dist/server.js"]
